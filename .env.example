# Application
DEBUG=False
APP_NAME=Cloud Policy Checker

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cloud_policy

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1

# Azure
AZURE_DISCOVERY_ENABLED=false
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# AWS
AWS_DISCOVERY_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Google Cloud
GCP_DISCOVERY_ENABLED=false
GCP_PROJECT_ID=
